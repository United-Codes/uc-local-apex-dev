# Example .env for uc-local-apex-dev.
#
# This is a REFERENCE only. You normally never write .env by hand:
# ./setup.sh generates it (with freshly random passwords) on first run, and
# ./install.sh reuses it afterwards. The real .env is gitignored.
#
# Copy to .env only if you want to pre-seed values yourself:
#   cp .env.example .env   # then replace every CHANGE_ME below

# --- Database (SYS) credentials ---------------------------------------------
# ORACLE_PASSWORD / ORACLE_PWD must match (the Oracle image reads ORACLE_PWD;
# the scripts read ORACLE_PASSWORD). setup.sh generates a random 16-char value.
ORACLE_PASSWORD="CHANGE_ME"
ORACLE_PWD="CHANGE_ME"

# --- SQLcl saved-connection naming ------------------------------------------
DB_CONN_BASE=local-26ai       # prefix for saved SQLcl connections
DB_CONN_NAME=local-26ai-sys   # SYS connection: sql -name "$DB_CONN_NAME"

# --- Container / DB service --------------------------------------------------
CONTAINER_NAME=local-26ai
DBSERVICENAME="FREEPDB1"
DBHOST="26ai"                 # service name on the compose network (not the host)
DBPORT="1521"

# --- Hardening (install.sh --secure) ----------------------------------------
# SECURE_MODE is THIS project's flag. Do NOT rename it to FORCE_SECURE: the
# Oracle ORDS image reads FORCE_SECURE from this shared env_file and would then
# refuse to boot without TLS certs. `install.sh --secure` sets SECURE_MODE=true.
SECURE_MODE="false"

# ORDS debug-to-screen (maps to the container's DEBUG env, which the image turns
# into debug.printDebugToScreen every boot). Default on for dev; `install.sh
# --secure` flips this to false. Do NOT rename to ORDS_DEBUG: that is reserved
# inside the ORDS launcher (JVM -agentlib:jdwp options) and breaks the install.
DEBUG_TO_SCREEN="true"

# --- Optional knobs ---------------------------------------------------------
# Container restart policy (both services). Default "no"; hosted installs may
# prefer "unless-stopped". Keep it quoted.
# RESTART_POLICY="no"

# Make `create-user` use the random INTERNAL/ORACLE_PASSWORD for new workspaces
# instead of the shared 'Welcome_1'. SECURE_MODE=true implies this.
# WORKSPACE_USE_INTERNAL_PASSWORD="false"

# Ceiling for each per-schema tablespace that `create-user` creates. Takes an
# Oracle size literal, for example 512M or 2G. The Free edition allows 12 GB of
# datafiles per PDB in total, so this stops one schema from consuming all of it.
# USER_TBS_MAXSIZE="2G"

# Thresholds for `used-space`, in GB against the 12 GB Free-edition limit.
# `used-space` exits 10 at WARN and 11 at CRIT, and `stop` warns before it shuts
# the database down. The warning default is deliberately below the limit: undo,
# TEMP and a rescue export all need room, and at 11 GB none of that is left.
# SPACE_WARN_GB="9.5"
# SPACE_CRIT_GB="11"

# --- Per-app schema passwords (added by create-user, one per workspace) ------
# <NAME>_USER_PASSWORD="..."
